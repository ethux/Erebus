# Erebus deployable gateway - operator configuration template (008 FR-001/009/012).
#
# Copy this file to `gateway.env`, fill in the required values, and launch the gateway
# (via `docker compose --env-file gateway.env ...` or by exporting these into the process
# environment for `erebus-gateway`). Every setting below maps to a field of
# `erebus.gateway.config.GatewayConfig`; `from_env()` format-validates them and the
# `erebus-gateway` entrypoint probes the live dependencies, exiting non-zero before binding
# on any failure (never serving half-open).
#
# Secret hygiene (FR-012): the master key and any provider credentials are read here and
# held only in memory or wrapped/hashed at rest. They MUST NOT appear in logs, telemetry,
# or audit. Do not commit a filled-in copy of this file.

# --- Required ---------------------------------------------------------------------------

# Shared-state Postgres DSN. All replicas point at the one store (tokens minted by one
# replica restore on another). Example: postgresql://user:pass@postgres:5432/erebus_gateway
EREBUS_PG_DSN=postgresql://erebus:erebus@postgres:5432/erebus_gateway

# base64-encoded 32-byte software master key for key custody (AES-256). Never logged; only
# per-scope KEKs wrapped by it are persisted. Generate with:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Admin routes need an operator credential. Create the first one inside the running container:
#   docker compose -f deploy/docker-compose.yml exec gateway erebus-gateway create-operator
# It uses this key and EREBUS_PG_DSN in-process and prints the token once; the key is never
# sent over HTTP.
EREBUS_GATEWAY_MASTER_KEY=

# Default upstream provider used when a request's model is not in MODEL_MAP (e.g. openai).
EREBUS_GATEWAY_PROVIDER=openai

# --- Listen address ---------------------------------------------------------------------

# Bind host. Default: 0.0.0.0 (a gateway binds all interfaces by design).
EREBUS_GATEWAY_HOST=0.0.0.0

# Bind port (1..65535). Default: 8080.
EREBUS_GATEWAY_PORT=8080

# --- Routing ----------------------------------------------------------------------------

# Optional JSON object of model->provider overrides for routing. Default: {} (empty, all
# models route to EREBUS_GATEWAY_PROVIDER). Example: {"claude-3-5-sonnet":"anthropic"}
# EREBUS_GATEWAY_MODEL_MAP={}

# --- Detection --------------------------------------------------------------------------

# Regex-only detection. Default: off (regex + GLiNER; while GLiNER is down requests fail
# closed with 503, never falling back to regex alone). Set to 1/true to run without GLiNER:
# emails, international phone numbers, IBANs, API keys, private keys and key=value secrets
# are still tokenized; names, addresses, organisations and national phone formats are not.
# /readyz reports "detection": "regex-only". Accepted truthy values: 1, true, yes, on.
# EREBUS_DISABLE_GLINER=0

# --- Connection pool (R10 tunable) ------------------------------------------------------

# psycopg_pool sizing. Must satisfy 1 <= MIN <= MAX. Defaults: MIN=2, MAX=8. Size MAX to
# expected concurrent DB ops (connections are held only for brief units), not total users.
# EREBUS_GATEWAY_POOL_MIN=2
# EREBUS_GATEWAY_POOL_MAX=8

# --- Upstream transport -----------------------------------------------------------------

# Upstream httpx request timeout, in seconds (> 0). Default: 30.
# EREBUS_GATEWAY_HTTP_TIMEOUT=30

# --- Overload control -------------------------------------------------------------------

# Per-tenant concurrency slots (>= 0). 0 = unlimited (the default). When set, a burst over
# the cap is shed gracefully (503 + Retry-After) to preserve per-tenant fairness.
# EREBUS_GATEWAY_CONCURRENCY=0

# --- Graceful shutdown ------------------------------------------------------------------

# Drain window in seconds before in-flight work aborts fail-closed on SIGTERM/SIGINT
# (> 0). Default: 30.
# EREBUS_GATEWAY_SHUTDOWN_TIMEOUT_S=30

# --- Known values -----------------------------------------------------------------------

# Seconds between checks for changed tenant catalogs (> 0). A changed tenant's matcher is
# rebuilt in the background; /readyz is 503 until the first build pass. Default: 5.
# EREBUS_GATEWAY_CATALOG_POLL_S=5

# --- Sync worker (erebus-sync) ----------------------------------------------------------

# The sync worker reads EREBUS_PG_DSN, EREBUS_GATEWAY_MASTER_KEY and EREBUS_DISABLE_GLINER
# from above (with GLiNER on, it also reviews sampled fields with the model) plus these.
# Seconds between polls for queued jobs, and how many jobs run at once. Defaults: 5, 2.
# EREBUS_SYNC_POLL_S=5
# EREBUS_SYNC_CONCURRENCY=2
# A running job heartbeats every HEARTBEAT_S; one silent for LEASE_S is re-queued (the
# third time it fails). Must satisfy HEARTBEAT_S < LEASE_S. Defaults: 30, 600.
# EREBUS_SYNC_HEARTBEAT_S=30
# EREBUS_SYNC_LEASE_S=600
# Retry waits, in seconds, after an unreachable source or a failed query; the job fails
# after the last one. Default: 60,300,900.
# EREBUS_SYNC_BACKOFF_S=60,300,900
# How long a job may wait on a source's rate limit before it fails. Default: 172800 (48 h).
# EREBUS_SYNC_LIMIT_WAIT_S=172800
# Most active known values per tenant; a sync that would pass it fails. Default: 1000000.
# EREBUS_SYNC_TENANT_MAX_VALUES=1000000
# Comma-separated host names, addresses and CIDR networks the worker never connects to.
# Setting it replaces the default: the database host in EREBUS_PG_DSN (its whole cluster),
# loopback, 0.0.0.0/8, link-local (cloud metadata at 169.254.169.254), fd00:ec2::254 and
# 100.100.100.200. `none` denies nothing (tests only).
# EREBUS_SYNC_DENIED_HOSTS=
# When set, the worker connects only to these host names, addresses or networks.
# EREBUS_SYNC_ALLOWED_HOSTS=
# Directory SQLite sources must live in (symlinks are followed and must stay inside).
# Unset: SQLite sources are refused.
# EREBUS_SYNC_SQLITE_DIR=

# --- Erebus Pro license -----------------------------------------------------------------

# Optional. Without a key only core features run; a missing, expired or invalid key never
# stops the gateway or the sync worker. Scheduled syncs need the key in the sync worker's
# environment too (the compose file shares this file). Check the result at GET /v1/license.
# Use one of the two:
# EREBUS_LICENSE_KEY=erebus1....
# EREBUS_LICENSE_FILE=/run/secrets/erebus-license
